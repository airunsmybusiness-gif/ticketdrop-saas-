# Copy this file to secrets.toml and fill in REAL values.
# secrets.toml is gitignored and must NEVER be committed.
#
# On Streamlit Cloud / Render / Railway, set these as environment
# variables or "secrets" in the hosting dashboard instead of a file.

DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/postgres"

# Temporary shared passwords — replace with real per-user login (see ROADMAP.md)
DISPATCH_PASSWORD = "change-me"
AR_PASSWORD = "change-me"
DRIVER_PIN = "0000"
ADMIN_PASSWORD = "change-me"
